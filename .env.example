# Web App
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=RA Community Management
NEXT_PUBLIC_GA_ID=
# Used by next.config.js server-side rewrite rule (not exposed to the browser)
BACKEND_URL=http://localhost:8000

# Backend
DATABASE_URL=postgresql://ra_user:ra_password@localhost:5432/ra_db
BACKEND_ENV=development
BACKEND_DEBUG=False
# ⚠️ SECURITY: Generate a strong key for production:
#   python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY_64_CHARS_MIN
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# JWT
# ⚠️ SECURITY: Generate a strong secret (≥ 64 chars) for production:
#   python -c "import secrets; print(secrets.token_hex(64))"
# The application will REFUSE TO START if this is a known weak placeholder.
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_JWT_SECRET_64_CHARS_MIN
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# SQL logging (development only — NEVER set to True in production)
BACKEND_SQL_ECHO=False

# Email (for password reset, notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@racommunity.local

# OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Redis (for caching, rate limiting)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=3600

# Mobile App
REACT_NATIVE_API_URL=http://localhost:8000/api
REACT_NATIVE_ENV=development
